# Copy to $DEPLOY_PATH/.env.production on the server. Never commit the real file.

# GitHub user/org owning the GHCR image (lowercase).
GHCR_OWNER=your-github-username
# Public hostname; the host Caddy (caddy-docker-proxy) routes it to the server container.
PUBLIC_HOSTNAME=kanbot.example.com
# Image tag to deploy. Overridden per-deploy by CI; "latest" is a sane local default.
IMAGE_TAG=latest

# Generate with: openssl rand -hex 32 (hex, so it is safe inside DATABASE_URL)
POSTGRES_PASSWORD=
# Signs JWT access tokens. Generate with: openssl rand -base64 48
# Rotating it logs every user out.
JWT_SECRET=

# New accounts need a signup invite (see README "Invite users"). Set to false to allow anyone to register.
REGISTRATION_DISABLED=true
