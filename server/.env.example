# Postgres connection string (docker compose `db` service exposes 5432 by default; override with DB_PORT)
DATABASE_URL=postgres://kanbot:kanbot@localhost:5432/kanbot
# Secret used to sign JWT access tokens (HS256). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL of this server; used to build invite URLs.
PUBLIC_URL=http://localhost:8787
# HTTP port (default 8787)
PORT=8787
