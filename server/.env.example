# Postgres connection string (docker compose `db` service listens on 127.0.0.1:5432 by default; override with DB_PORT)
DATABASE_URL=postgres://kanbot:kanbot@localhost:5432/kanbot
# Secret used to sign JWT access tokens (HS256). Generate with: openssl rand -base64 48
# With NODE_ENV=production the server rejects secrets shorter than 32 chars or containing "insecure"/"change-me"
# (so this placeholder only works in development). docker compose needs JWT_SECRET too: see README.
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL of this server; used to build invite URLs.
PUBLIC_URL=http://localhost:8787
# HTTP port (default 8787)
PORT=8787
# When true, registering requires a signup invite from `bun run invite:create` (default false)
REGISTRATION_DISABLED=false
